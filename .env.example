# Copy to .env.local and fill in. Never commit the filled version.

# Neon Postgres — "Connection string" from the Neon project dashboard.
# Keep ?sslmode=require. The pooled host is the one ending in -pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Anthropic — console.anthropic.com → API keys. Server-side only.
# No NEXT_PUBLIC_ prefix: that would ship the key to the browser.
ANTHROPIC_API_KEY="sk-ant-..."

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated allowlist. Everything in the app sits behind auth, so an
# address that is not on this list cannot read either — there is no public view.
#
# Matched against the email GitHub reports for the signed-in account, which is
# whatever that person set as their primary address — often a personal one
# rather than a work one. Confirm each address with the person rather than
# guessing, or they get a sign-in that fails with nothing to explain why.
#
# The list is all-or-nothing: every entry gets full read, write and delete.
#
# Real addresses go in .env.local, which is gitignored. This file is committed,
# so anything written here ships with the repository — including other
# people's work addresses.
ALLOWED_EMAILS="you@example.com,someone-else@example.com"

# How many past messages travel to the model on each Claude request.
# Everything is still stored; this only bounds what is sent.
CLAUDE_CONTEXT_MESSAGES="20"
